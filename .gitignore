node_modules/
frontend/dist/
*.tsbuildinfo
npm-debug.log*

# ---- Editors and OS ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
.DS_Store
Thumbs.db
